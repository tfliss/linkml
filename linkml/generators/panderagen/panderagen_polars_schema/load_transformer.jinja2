import polars as pl
import panderagen_polars_schema as serialized_schema
import panderagen_polars_schema_loaded as loaded_schema
import linkml.generators.panderagen.transforms.new_transforms as nt

{%- macro render_slot2(field) -%}
    {%- if field.inline_form == 'inline_collection_dict' %}
                nt.CollectionToStructTransformer(struct_schema=loaded_schema.{{ field.reference_class }}Struct).load('{{ field.name }}'),
    {%- elif field.inline_form == 'simple_dict' %}
                nt.DictToStructTransformer(
                    id_col="{{ field.inline_id_column_name }}",
                    other_col="{{ field.inline_other_column_name }}",
                    id_dtype=pl.String, # TODO: need real implementation
                    other_dtype=loaded_schema.{{ field.inline_other_range }},
                ).load('{{ field.name }}'),
    {% else -%}
    {#- No operation on other forms -#}
    {%- endif -%}
{%- endmacro -%}

{%- macro render_with_columns2(cls) %}
            .with_columns(
{% for field in cls.fields %}{{ render_slot2(field) }}{% endfor %}
            )
{% endmacro -%}

{%- for cls in doc.classes %}
class {{cls.name }}(object): #LinkmlPolarsTransformer):
    _polars_serialized_schema_struct = serialized_schema.{{ cls.name }}Struct
    _polars_serialized_schema_dict = serialized_schema.{{ cls.name }}Dict
    _polars_loaded_schema_struct = loaded_schema.{{ cls.name }}Struct
    _polars_loaded_schema_dict = loaded_schema.{{ cls.name }}Dict

    def load(self, df: pl.DataFrame) -> pl.DataFrame:
        return (
            df.lazy()
{{ render_with_columns2(cls) }}
            .collect()
        )
{% endfor -%}
